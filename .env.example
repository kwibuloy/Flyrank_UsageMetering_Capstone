# Copy to .env and fill in. Never commit .env.

# Database. docker compose sets these for its containers; the values below are for
# running Python on the host against the compose Postgres (published on port 5433).
DATABASE_URL=postgresql+psycopg://billing:billing@localhost:5433/billing
TEST_DATABASE_URL=postgresql+psycopg://billing:billing@localhost:5433/billing_test

# Stripe — TEST MODE ONLY (keys start with sk_test_). Never use live keys.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
# Usage on the invoice (optional): created by scripts/stripe_setup_metering.py and found by
# lookup key, so nothing to fill in. Override only if you renamed them in Stripe.
# STRIPE_METER_EVENT_NAME=usage_cost_picousd
# STRIPE_USAGE_PRICE_LOOKUP_KEY=pro_usage_picousd

# Used for Checkout success/cancel URLs
PUBLIC_BASE_URL=http://localhost:8000

# Pricing constants file (pinned)
PRICING_CONFIG_PATH=config/pricing.toml

# Usage alerts at 80% / 100% of a quota (optional). Empty = written to the worker log.
# Any HTTPS endpoint that accepts JSON works, e.g. a Slack incoming webhook.
ALERT_WEBHOOK_URL=
# Optional: signs each alert as X-Alert-Signature: t=<unix>,v1=<hmac-sha256>
ALERT_WEBHOOK_SECRET=

LOG_LEVEL=INFO

# Scaling (optional). API processes x (pool + overflow) + worker must stay under Postgres
# max_connections (100). Defaults: 4 processes x (5 + 5) + worker 10 = 50.
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
